<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ElectronicShopApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ElectronicShopApp.Views"
    Title="ElectronicShopApp">

    <!--<ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />-->
    <TabBar>
        <Tab Title="Główna" >
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}"   Title="Home"/>
        </Tab>

        <Tab Title="Szukaj">
            <ShellContent ContentTemplate="{DataTemplate local:SearchPage}" Title="Search"/>
        </Tab>

        <Tab Title="Profil">
            <ShellContent ContentTemplate="{DataTemplate local:ProfilePage}" Title="Profile" />
        </Tab>
    </TabBar>
</Shell>
