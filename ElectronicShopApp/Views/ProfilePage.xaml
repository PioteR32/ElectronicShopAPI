<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:modelViews="clr-namespace:ElectronicShopApp.ViewModels;assembly=ElectronicShopApp.ViewModels"
             xmlns:views="clr-namespace:ElectronicShopApp.Views.ProfilePageViews"
             xmlns:defaultViews="clr-namespace:ElectronicShopApp.Views.Default"
             xmlns:selectors="clr-namespace:ElectronicShopApp.Selectors"
             x:Class="ElectronicShopApp.Views.ProfilePage"
             x:Name="this"
             Title="ProfilePage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- 1. Szablony wiążące ViewModel z odpowiednim ContentView -->
            <DataTemplate x:Key="ProfileDataTemplate">
                <views:ProfileDataView />
            </DataTemplate>

            <DataTemplate x:Key="ProfileListsTemplate">
                <views:ProfileListsView />
            </DataTemplate>

            <!-- 2. Rejestracja Selectora -->
            <selectors:ProfilePageViewsTemplateSelector x:Key="SelectorView"
                                           ProfileDataViewModel="{StaticResource ProfileDataTemplate}"
                                           ProfileListsViewModel="{StaticResource ProfileListsTemplate}" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!--<ContentPage.BindingContext>
    <modelViews:ProfilePageViewModel />
</ContentPage.BindingContext>-->

    <VerticalStackLayout>
        <Grid 
            ColumnDefinitions="*,*,*" 
            RowDefinitions="*,*,*"
            
            IsVisible="False"
            >
            <Grid.Triggers>
                <DataTrigger TargetType="Grid" 
                    Binding="{Binding IsUserLoggedIn}" 
                    Value="False">
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>
            </Grid.Triggers>


            <defaultViews:LogInView
                EntryName="{Binding EntryName}"
                EntryPassword="{Binding EntryPassword}"
                Grid.Column="1" 
                Grid.Row="1">
                <defaultViews:LogInView.Triggers>
                    <DataTrigger TargetType="defaultViews:LogInView" 
                            Binding="{Binding IsRegistration}" 
                            Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </defaultViews:LogInView.Triggers>
            </defaultViews:LogInView>

            <defaultViews:RegistrationView 
                IsVisible = "{Binding IsRegistration}" 
                Grid.Column="1" 
                Grid.Row="1" />

            <Button Text="Przejdź do rejestracji"  Command="{Binding GoToRegistrationCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" 
                        Binding="{Binding IsRegistration}" 
                         Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Text="Przejdź do logowania" IsVisible = "{Binding IsRegistration}"  Command="{Binding GoToLoginCommand}"/>

            <Button 
                Text="Logowanie" 
                Command="{Binding LogInCommand}"
                Grid.Row="2" 
                Grid.Column="1" 
                HorizontalOptions="Center"  
                VerticalOptions="Start" 
                Margin="20">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" 
                        Binding="{Binding IsRegistration}" 
                        Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            
            <Button
                IsVisible = "{Binding IsRegistration}" 
                Text="Zarejestruj konto" 
                Command="{Binding RegistrationCommand}"
                Grid.Row="2" 
                Grid.Column="1" 
                HorizontalOptions="Center"  
                VerticalOptions="Start" 
                Margin="20"/>

        </Grid>
        <Grid RowDefinitions="*, Auto"
              Padding="20"
              RowSpacing="10"
              IsVisible="{Binding IsUserLoggedIn}">


            <StackLayout Grid.Row="0"
                         BindableLayout.ItemsSource="{Binding CurrentSubViewModelCollection}"
                         BindableLayout.ItemTemplateSelector="{StaticResource SelectorView}" 
                         IsVisible="{Binding IsUserInAbility}"/>

            <CollectionView ItemsSource="{Binding SubViewModels }"
                            IsVisible="False"
                            >
                <CollectionView.Triggers>
                    <DataTrigger 
                        TargetType="CollectionView"
                        Binding="{Binding IsUserInAbility}" 
                        Value="False">
                        <Setter Property="IsVisible" Value="True"/>
                    </DataTrigger>
                </CollectionView.Triggers>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Button 
                            Text="{Binding Title}" 
                            Command="{Binding BindingContext.ButtonClickedViewCommand,Source={x:Reference this}}" 
                            CommandParameter="{Binding Index}"
                            Margin="10"
                            />
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </Grid>
    </VerticalStackLayout>
</ContentPage>