<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:modelViews="clr-namespace:ElectronicShopApp.ViewModels"
             xmlns:views="clr-namespace:ElectronicShopApp.Views.ProfilePageViews"
             xmlns:selectors="clr-namespace:ElectronicShopApp.Selectors"
             x:Class="ElectronicShopApp.Views.ProfilePage"
             x:Name="this"
             Title="ProfilePage">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- 1. Szablony wiążące ViewModel z odpowiednim ContentView -->
            <DataTemplate x:Key="ProfileDataTemplate">
                <views:ProfileDataView />
            </DataTemplate>

            <DataTemplate x:Key="ProfileListsTemplate">
                <views:ProfileListsView />
            </DataTemplate>

            <!-- 2. Rejestracja Selectora -->
            <selectors:ProfilePageViewsTemplateSelector x:Key="SelectorView"
                                           ProfileDataViewModel="{StaticResource ProfileDataTemplate}"
                                           ProfileListsViewModel="{StaticResource ProfileListsTemplate}" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <!--<ContentPage.BindingContext>
    <modelViews:ProfilePageViewModel />
</ContentPage.BindingContext>-->
    
    <VerticalStackLayout>
        <Grid 
            ColumnDefinitions="*,*,*" 
            RowDefinitions="*,*,*"
            IsVisible="False"
            >
            <Grid.Triggers>
                <DataTrigger TargetType="Grid" 
                    Binding="{Binding IsUserLoggedIn}" 
                    Value="False">
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>
            </Grid.Triggers>
            <Grid 
                ColumnDefinitions="*,*" 
                RowDefinitions="*,*,*"
                Grid.Column="1" 
                Grid.Row="1"
                RowSpacing="20"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Label 
                    Grid.ColumnSpan="2" 
                    Text="Logowanie" 
                    FontSize="Header" />
                <Label 
                    Text="e-mail: " 
                    VerticalOptions="Center" 
                    Grid.Row="1" />
                <Entry 
                    Text="{Binding EntryName}" 
                    Grid.Column="1" 
                    Grid.Row="1" />


                <Label 
                    Text="password: " 
                    VerticalOptions="Center" 
                    Grid.Row="2"/>
                <Entry 
                    Text="{Binding EntryPassword}" 
                    HeightRequest="10" 
                    Grid.Column="1" 
                    Grid.Row="2"/>

            </Grid>
            
            <Button 
                Text="Logowanie" 
                Command="{Binding LogInCommand}"
                Grid.Row="2" 
                Grid.Column="1" 
                HorizontalOptions="Center"  
                VerticalOptions="Start" 
                Margin="20"/>
            
        </Grid>
        <Grid RowDefinitions="*, Auto" Padding="20"
              IsVisible="{Binding IsUserLoggedIn}">

            <!-- MIEJSCE WYŚWIETLANIA DYNAMICZNEGO CONTENT VIEW -->
            <!-- BindableLayout expects a collection. Use a one-item collection from the VM so
                 the existing ItemTemplateSelector (SelectorView) can choose the correct view. -->
            <StackLayout Grid.Row="0"
                         BindableLayout.ItemsSource="{Binding CurrentSubViewModelCollection}"
                         BindableLayout.ItemTemplateSelector="{StaticResource SelectorView}" 
                         IsVisible="{Binding IsUserInAbility}"/>
            <!-- PRZYCISKI STERUJĄCE -->
            <!--<Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                <Button Grid.Column="0" 
                    Text="Cofnij" 
                    Command="{Binding PreviousViewCommand}" />

                <Button Grid.Column="1" 
                    Text="Dalej" 
                    Command="{Binding NextViewCommand}" />
            </Grid>-->
            <CollectionView ItemsSource="{Binding SubViewModels }"
                            IsVisible="False">
                <CollectionView.Triggers>
                    <DataTrigger 
                        TargetType="CollectionView"
                        Binding="{Binding IsUserInAbility}" 
                        Value="False">
                        <Setter Property="IsVisible" Value="True"/>
                    </DataTrigger>
                </CollectionView.Triggers>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Button 
                            Text="{Binding Title}" 
                            Command="{Binding BindingContext.ButtonClickedViewCommand,Source={x:Reference this}}" 
                            CommandParameter="{Binding Index}"
                            />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                
            </CollectionView>
        </Grid>
    </VerticalStackLayout>
</ContentPage>