<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ElectronicShopApp.Views.SearchPage"
             xmlns:modelViews="clr-namespace:ElectronicShopApp.ViewModels"
             xmlns:converters="clr-namespace:ElectronicShopApp.Converters"
             xmlns:views="clr-namespace:ElectronicShopApp.Views"
             Title="SearchPage">
    <!--<ContentPage.BindingContext>
        <modelViews:SearchPageViewModel />
    </ContentPage.BindingContext>-->
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IntToSearchPageStateConverter x:Key="IntToSearchPageState" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>


            <Button Text="Search" Grid.Column="0" ></Button>
            <Entry Placeholder="Search for products..." Grid.Column="1" Text="{Binding SearchText}" />

        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Text="Products" Grid.Column="0" Command="{Binding ChangeView}" CommandParameter="0" ></Button>
            <Button Text="Choose Categories" Grid.Column="1" Command="{Binding ChangeView}" CommandParameter="1" />
            <Button Text="Filters" Grid.Column="2" Command="{Binding ChangeView}" CommandParameter="2" />

        </Grid>
        <ScrollView Grid.Row="2">
        <views:MainSearchPageView 
            ProductClickCommand="{Binding ProductClickedCommand}"
            CategoryBackCommand="{Binding CategoryBackCommand}"
            CategoryClickCommand="{Binding CategoryClickCommand}"                   
            FilterClickedCommand="{Binding FilterClickedCommand}"
            FilterOptionClickedCommand="{Binding FilterOptionClickCommand}"      
            FilterSaveClickedCommand="{Binding SaveFilterOptionsCommand}"
           
            CurrentState="{Binding CurrentState}"
            
            Filters="{Binding Filters}"
            Categories="{Binding Categories}"
            Products="{Binding Products}"/>
        </ScrollView>
        
    </Grid>
</ContentPage>