    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IntToSearchPageStateConverter x:Key="IntToSearchPageState" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView >
        <VerticalStackLayout>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>


                <Button Text="Search" Grid.Column="0" ></Button>
                <Entry Placeholder="Search for products..." Grid.Column="1" Text="{Binding SearchText}" />

            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Text="Products" Grid.Column="0" Command="{Binding ChangeView}" CommandParameter="0" ></Button>
                <Button Text="Choose Categories" Grid.Column="1" Command="{Binding ChangeView}" CommandParameter="1" />
                <Button Text="Filters" Grid.Column="2" Command="{Binding ChangeView}" CommandParameter="2" />

            </Grid>
            <views:MainSearchPageView 
            CategoryClickCommand="{Binding CategoryClickCommand}"                   
            FilterClickedCommand="{Binding FilterClickedCommand}"
            FilterOptionClickedCommand="{Binding FilterOptionClickCommand}"      
            
            CurrentState="{Binding CurrentState}"
            
            Filters="{Binding Filters}"
            Categories="{Binding Categories}"
            Products="{Binding Products}"/>
