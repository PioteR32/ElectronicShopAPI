<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ElectronicShopApp.Views.SearchPage"
             xmlns:modelViews="clr-namespace:ElectronicShopApp.ViewModels"
             xmlns:converters="clr-namespace:ElectronicShopApp.Converters"
