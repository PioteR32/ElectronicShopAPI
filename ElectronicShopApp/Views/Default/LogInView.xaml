<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ElectronicShopApp.Views.Default.LogInView"
             x:Name='this'>
    <Grid 
                ColumnDefinitions="*,*" 
                RowDefinitions="*,*,*"
                Grid.Column="1" 
                Grid.Row="1"
                RowSpacing="20"
                HorizontalOptions="Center"
                VerticalOptions="Center">
        <Label 
              Grid.ColumnSpan="2" 
              Text="Logowanie" 
              FontSize="Header" />
        <Label 
             Text="e-mail: " 
             VerticalOptions="Center" 
             Grid.Row="1" />
        <Entry 
             Text="{Binding EntryName,Source={x:Reference this}}" 
             Grid.Column="1" 
             Grid.Row="1" />
        <Label 
            Text="password: " 
            VerticalOptions="Center" 
            Grid.Row="2"/>
        <Entry 
            Text="{Binding EntryPassword,Source={x:Reference this}}" 
            HeightRequest="10" 
            Grid.Column="1" 
            Grid.Row="2"/>

    </Grid>

    
</ContentView>
