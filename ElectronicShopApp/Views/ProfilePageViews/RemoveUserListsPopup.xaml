<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:DataType="vm:ICheckedUserListsPopupViewModel"
               x:Class="ElectronicShopApp.Views.ProfilePageViews.RemoveUserListsPopup"
               xmlns:vm="clr-namespace:ElectronicShopApp.ViewModels"
               xmlns:vmDto="clr-namespace:ElectronicShopApp.ViewModels.DTOs"
               >

    <Border StrokeShape="RoundRectangle 15"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
         >
        <Grid ColumnDefinitions="*,*" 
                  RowDefinitions="2*,5*,*"
                  ColumnSpacing="10">
            <Label 
                    Text="{Binding Title}"
                    FontSize="Header"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center"
                    Grid.ColumnSpan="2"/>
            <CollectionView 
                    ItemsSource="{Binding CheckedUserLists}"
                    Grid.ColumnSpan="3"
                    Grid.Row="1">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid x:DataType="vmDto:CheckedUserListDTOViewModel" ColumnDefinitions="*,*">
                            <Label Text="{Binding UserListDto.Name}" />
                            <CheckBox IsChecked="{Binding IsChecked}" Grid.Column="1" HorizontalOptions="End"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="Cancel" 
                        Command="{Binding CancelCommand}" 
                        Grid.Row="2"/>
            <Button Text="Confirm" 
                        Command="{Binding ConfirmCommand}" 
                        Grid.Row="2"
                        Grid.Column="1"/>
        </Grid>
    </Border>
</toolkit:Popup>