<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ElectronicShopApp.ViewModels"
             x:DataType="vm:ProfileListsViewModel"
             x:Class="ElectronicShopApp.Views.ProfilePageViews.ProfileListsView">
    <Border Stroke="#008000" StrokeThickness="2" Padding="20" Margin="10">
        <VerticalStackLayout Spacing="15">
            <Button Text="Back" Command="{Binding BackCommand}"/>
            <Label Text="{Binding Title}" FontSize="20" FontAttributes="Bold" TextColor="#008000" />
                
            <Entry Text="{Binding City}" Placeholder="Wpisz miasto..." />
        </VerticalStackLayout>
    </Border>
</ContentView>
