<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:Shared.DTO;assembly=Shared"
             xmlns:viewModels="clr-namespace:ElectronicShopApp.ViewModels;assembly=ElectronicShopApp.ViewModels"
             x:DataType="viewModels:ProfileListsViewModel"
             x:Class="ElectronicShopApp.Views.ProfilePageViews.ProfileListsView"
             x:Name="View">
    <Border Stroke="#008000" StrokeThickness="2" Padding="20" Margin="10">
        <VerticalStackLayout Spacing="15">
            
            <Grid ColumnDefinitions="*,*,*,*">
                <Button Text="Back" 
                        Command="{Binding BackCommand}"/>
                <Label Text="{Binding Title}" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       TextColor="#008000" 
                       Grid.Column="1"/>

                <Button Text="+" 
                        FontSize="20" 
                        FontAttributes="Bold" 
                        TextColor="#008000" 
                        Command="{Binding AddListCommand}"
                        Grid.Column="2"/>

                <Button Text="-" 
                        FontSize="20" 
                        FontAttributes="Bold" 
                        TextColor="#008000" 
                        Command="{Binding RemoveListCommand}"
                        Grid.Column="3"/>
            </Grid>
            <Grid BackgroundColor="Black">
                <CollectionView ItemsSource="{Binding UserLists}"
                                >
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid x:DataType="dtos:UserListDTO" >
                            <VerticalStackLayout  >
                                <Label Text="{Binding Name}"/>
                                <Label Text="{Binding Description}"/>
                            </VerticalStackLayout>
                                <Button BackgroundColor="Transparent"  
                                        Command="{Binding Source={x:Reference Name=View}, Path=BindingContext.GoToItemsPageCommand}"
                                        CommandParameter="{Binding .}"
                                       ></Button>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
