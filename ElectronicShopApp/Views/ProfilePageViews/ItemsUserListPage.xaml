<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:Shared.DTO;assembly=Shared"
             xmlns:viewModels="using:ElectronicShopApp.ViewModels"
             x:Class="ElectronicShopApp.Views.ProfilePageViews.ItemsUserListPage"
             x:Name="self">
    <!--<ContentPage.BindingContext>
        <viewModels:ItemsUserListViewModel/>
    </ContentPage.BindingContext>-->
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Spacing="15" Padding="20">
                <Grid ColumnDefinitions="*,*,*">
                    <Button Text="Delete Checked Items" 
                              Command="{Binding DeleteItemsCommand}"
                              Grid.Column="0"/>
                    <Label Text="{Binding ListName}" 
                            FontSize="20" 
                            FontAttributes="Bold" 
                            TextColor="#008000" 
                            Grid.Column="1"
                            HorizontalOptions="Center"/>
                </Grid>

                <Label Text="Items in this list:" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       TextColor="#008000"/>

                <CollectionView ItemsSource="{Binding UserListItems}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,20*" >
                                <VerticalStackLayout 
                                    Grid.Column="1">
                                    <Label Text="{Binding UserListItemDTO.ProductName}" 
                                           FontSize="16" 
                                           FontAttributes="Bold"/>

                                    <Label 
                                        Text="{Binding UserListItemDTO.Quantity, StringFormat='Quantity: {0}'}" 
                                        HorizontalOptions="End"/>

                                </VerticalStackLayout>
                                <CheckBox IsChecked="{Binding IsChecked}" Grid.Column="0"/>
                                <Button 
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    Command="{Binding Source={x:Reference self},Path=BindingContext.ItemClickedCommand}"    
                                    CommandParameter="{Binding .}"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>